# GEMINI_API_KEY: Required for the parking assistant only.
# Without it, /api/ai/assistant returns a clear "not configured" message.
# The map does not invent prices or space counts when this is missing.
# AI Studio injects this at runtime from the Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform key for the Google basemap and driving tilt.
# Without it the app shows OpenStreetMap and still loads car parks and kerb rules.
# Enable Maps JavaScript API for the key. Restrict it by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# TFL_APP_KEY: optional. TfL's Unified API answers anonymously at a lower rate limit.
# Register at https://api-portal.tfl.gov.uk/ and set the key to raise that limit.
# Live space counts come only from https://api.tfl.gov.uk/Occupancy/CarPark.
# As of 2026-11-03 that occupancy endpoint returns HTTP 500. The app then shows capacity, not a guessed count.
# TFL_APP_KEY=""

# On-street rules need no key:
# - Camden parking bays: https://opendata.camden.gov.uk/resource/7hiv-3r9k.json
# - OpenStreetMap map API for tagged kerb parking
# There is no public live feed of free on-street bays across all London boroughs.
